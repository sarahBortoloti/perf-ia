# Never commit .env or real credentials.
EASYPERF_BASE_URL=https://easyperf.example.test/
EASYPERF_USERNAME=
EASYPERF_PASSWORD=
# Leave these empty to choose them interactively.
EASYPERF_PROJECT=
EASYPERF_SQUAD=
# Use manual login for corporate SSO/MFA; automatic login requires credentials.
EASYPERF_MANUAL_LOGIN=true
